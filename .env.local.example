# Local overrides — copy to .env.local (gitignored).
# Loaded after .env and wins on conflicts. For laptop API dev only.

# === App mode (configs/config.json) ===
# dev  = local storage (data/local/trade_fills.json, seeded from samples)
# prod = live Robinhood via auth-service box (Render default)
APP_MODE=dev

# === Flask dev server ===
PORT=10000
FLASK_DEBUG=false
ENGINE_ENABLED=false
DRY_RUN=true

# === Robinhood via auth-service box ===
# Only needed with APP_MODE=prod (laptop needs SSH tunnel — see CLAUDE.md):
# AUTH_SERVICE_URL=https://34-30-182-125.sslip.io
# RH_AUTH_SERVICE_REQUEST_TOKEN=
