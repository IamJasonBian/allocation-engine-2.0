# === Broker Selection ===
ENABLED_BROKERS=robinhood,alpaca
DEFAULT_BROKER=robinhood

# === Robinhood ===
# Active account selection: "main" or "automated"
RH_ACTIVE_ACCOUNT=main

# Main account
RH_MAIN_EMAIL=
RH_MAIN_PASSWORD=

# Automated trading account
RH_AUTO_EMAIL=
RH_AUTO_PASSWORD=

RH_AUTOMATED_ACCOUNT_NUMBER=
RH_TOTP_SECRET=              # Base32 secret from authenticator app setup
RH_DEVICE_TOKEN=             # Optional: fixed device UUID
RH_PICKLE_NAME=taipei_session

# === IBKR (optional; enable with ENABLED_BROKERS=...,ibkr) ===
# Requires a running IB Gateway / TWS — see docs/IBKR_GATEWAY.md.
# HOST must be localhost or an SSH tunnel; the socket is unauthenticated.
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002            # IB Gateway paper; 4001 live (TWS: 7497/7496)
# IBKR_CLIENT_ID=1
# IBKR_PAPER=true

# === Alpaca (from 5thstreetcapital app) ===
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# === Runtime Service ===
RUNTIME_SERVICE_URL=https://route-runtime-service.netlify.app/api

# === Engine ===
POLL_INTERVAL_SECONDS=30
DRY_RUN=true
ENGINE_ENABLED=true
ENGINE_BROKER=alpaca

# === EPS dataset (write path: app/earnings_writer.py) ===
# AI-infra cohort. Written to data/eps.sqlite3 and exported to data/eps.json,
# which allocation-gym-2.0 reads. Refresh needs yfinance (not in requirements).
EPS_TICKERS=NVDA,AVGO,MU,MRVL,AMD,TSM,ARM,ALAB,CRDO,ANET,FTNT,CIEN,COHR,DELL,HPE,NTAP,SMCI,P,VRT,CRWV,NBIS,ORCL,SNOW,NET,DDOG,MDB
EPS_DB_PATH=
EPS_JSON_PATH=

# === Order-mutation routes (lookup / replace / cancel) ===
# Bearer token gating /api/robinhood/orders/* — fail closed: unset => 503.
DASHBOARD_REQUEST_TOKEN=

# === Slack ===
SLACK_WEBHOOK_URL=             # Incoming webhook for #allocation-infra

# === Auth-service (Robinhood session on external box) ===
AUTH_SERVICE_URL=
RH_AUTH_SERVICE_REQUEST_TOKEN=

# === Flask ===
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production
PORT=10000
